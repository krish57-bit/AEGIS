# Remote FalkorDB is the default. Embedded mode is an explicit optional install.
GRAPH_MODE=remote
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
# Optional for loopback development. For Compose use a long random alphanumeric
# password: the upstream REDIS_ARGS parser does not preserve whitespace.
FALKORDB_PASSWORD=

# Required for nonlocal deployments. Never commit a real shared API key.
AEGIS_API_KEY=
# Comma-separated allowlist, NOT per-user roles or authorization assignments.
AEGIS_ALLOWED_TENANTS=demo
# MCP tools cannot accept or override the tenant; it must be in the allowlist.
AEGIS_MCP_TENANT=demo
